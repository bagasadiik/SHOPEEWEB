# Telegram Bot Token (dapatkan dari @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Optional: Shopee Affiliate ID
AFFILIATE_ID=

# Optional: Admin Telegram User ID
ADMIN_ID=

# Optional: Proxy - isi HANYA jika api.telegram.org diblokir ISP/jaringanmu
# Contoh SOCKS5: socks5://127.0.0.1:1080
# Contoh HTTP  : http://127.0.0.1:8080
PROXY_URL=

# Optional: SSL / Sertifikat
# Jika muncul error "self-signed certificate in certificate chain" (biasanya
# karena antivirus/proxy yang menyadap HTTPS), ada 2 opsi:
#   1) Pakai CA bundle custom (AMAN) - arahkan ke root CA antivirus/proxy:
#      CA_BUNDLE=/path/ke/root-ca.pem
#   2) Matikan verifikasi SSL (DARURAT, TIDAK AMAN) - set ke false:
#      VERIFY_SSL=false
VERIFY_SSL=true
CA_BUNDLE=
